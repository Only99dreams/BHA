# Copy to supabase/functions/.env for local Supabase Edge Functions.
# Use Supabase Dashboard > Edge Functions > Secrets for deployed functions.
FLW_SECRET_KEY=replace-with-flutterwave-secret-key
FLW_SECRET_HASH=replace-with-flutterwave-webhook-hash
PREMBLY_API_KEY=replace-with-PREMBLY-key
OPENAI_API_KEY=replace-with-openai-api-key
