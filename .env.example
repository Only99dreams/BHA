VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only provider credentials. Do not prefix these with VITE_.
# For local Edge Functions, copy these values to supabase/functions/.env.
# For deployment, set them in Supabase Dashboard > Edge Functions > Secrets.
FLW_SECRET_KEY=replace-with-flutterwave-secret-key
FLW_SECRET_HASH=replace-with-flutterwave-webhook-hash
PREMBLY_API_KEY=replace-with-PREMBLY-key
OPENAI_API_KEY=replace-with-openai-api-key
GROQ_API_KEY=replace-with-groq-api-key
